# Copia este archivo como .env y llénalo. NO lo subas a GitHub.
# Cámara de botellas y latas. No uses la misma que CAMARA del reconocimiento facial.
CAMARA_CLASIFICACION=1
# IP que el ESP32 muestra en el LCD y en el monitor serial al arrancar.
ESP32_HOST=192.168.1.42
ESP32_PORT=8090
# Clasificador YOLO11n exportado a ONNX. Ruta relativa a esta carpeta.
MODELO=models/reciclaje.onnx
# Confianza mínima para aceptar botella o lata.
UMBRAL=0.70
# Solo hace falta si el ONNX no trae los nombres, en el orden del entrenamiento.
# CLASES=bottle,can,empty
