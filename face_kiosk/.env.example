# Copia este archivo como .env y llénalo. NO lo subas a GitHub.
SUPABASE_URL=https://ocarmdddmhtrrnlmupge.supabase.co
# Supabase > Project Settings > API Keys > service_role / secret (solo en la laptop del kiosko)
SUPABASE_SERVICE_ROLE_KEY=
# El mismo MACHINE_CODE que tiene flasheado la ESP32
MACHINE_CODE=ECO-48FM6V
# 0 = primera cámara. Si abre la cámara integrada de la laptop, prueba con 1
CAMERA_INDEX=0
# Similitud mínima para aceptar una cara (sube a 0.48 si confunde personas; baja a 0.38 si no reconoce)
MATCH_THRESHOLD=0.42
CONFIRM_FRAMES=4
SESSION_TTL_SECONDS=60
